{
  "version": "2.2.6",
  "name": "solid-map-gl",
  "description": "SolidJS Component Library for Mapbox GL JS & MapLibre GL JS",
  "info": "SolidJS Component Library for Mapbox GL JS & MapLibre GL JS. Mapbox GL JS and MapLibre GL JS are JavaScript libraries that render interactive maps from vector tiles and map styles using WebGL. This project is intended to be as close as possible to the Mapbox GL JS API.",
  "homepage": "https://gis-hub.gitbook.io/solid-map-gl",
  "author": "kaihuebner",
  "contributors": [
    {
      "name": "Kai Huebner",
      "email": "kai.huebner@gmail.com"
    }
  ],
  "keywords": [
    "gis",
    "map",
    "webgl",
    "mapbox-gl",
    "mapbox-gl-js",
    "mapbox",
    "maplibre",
    "solidjs"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "source": "./dist/index.jsx",
  "main": "./dist/index/index.js",
  "module": "./dist/index/index.js",
  "types": "./dist/index/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index/index.d.ts",
      "solid": "./dist/index/index.jsx",
      "import": {
        "types": "./dist/index/index.d.ts",
        "default": "./dist/index/index.js"
      },
      "default": "./dist/index/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "solid": "./dist/testing/index.jsx",
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "pub": "tsup && npm version patch && npm publish",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "docs:api": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIShub4/solid-map-gl.git"
  },
  "browserList": [
    "defaults",
    "not ie 11"
  ],
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "jsdom-worker": "^0.3.0",
    "mapbox-gl": "^3.30.0",
    "maplibre-gl": "^6.7.0",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@babylonjs/core": "^6.24.0",
    "@solidjs/testing-library": "^0.8.0",
    "mapbox-gl": "^3.0.0",
    "maplibre-gl": "^4.0.0 || ^5.0.0 || ^6.0.0",
    "solid-js": "^1.8.0 <2.0.0",
    "three": "^0.157.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "@solidjs/testing-library": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "browser": {},
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  }
}
